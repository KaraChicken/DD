NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Legacy account database used by Mem_Users_Accede.
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=YOUR_DATABASE
DB_USER=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# At least 32 random characters. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
