<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DDTank.Web</RootNamespace>
    <AssemblyName>DDTank.Web</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LocalData/DDTank.LocalData.csproj" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <Content Include="../Request/Illegalcharacters/Illegalcharacters.txt" Link="Data/Illegalcharacters.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Seeds/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
